---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact — Skyline Lodge</title>
    <meta name="description" content="Contact Skyline Lodge for booking inquiries and rental details." />
  </head>
  <body class="site-shell">
    <Navbar active="/contact" />
    <main>
      <section class="section page-hero">
        <div class="container">
          <div class="page-intro contact-layout">
            <div>
              <p class="eyebrow">Booking inquiry</p>
              <h1 class="section-title">Contact</h1>
              <p class="section-subtitle">Reserve your stay at Skyline Lodge or ask about availability, rates, seasonal recommendations, and what makes the cabin a good fit for your trip.</p>

              <div class="contact-details card">
                <div>
                  <p class="mini-label">Cabin</p>
                  <h3>Skyline Lodge</h3>
                </div>
                <div class="contact-detail-grid">
                  <div>
                    <p class="mini-label">Email</p>
                    <p>stay@skylinelodge.example</p>
                  </div>
                  <div>
                    <p class="mini-label">Phone</p>
                    <p>(555) 123-4829</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="card card-inner contact-card">
              <div class="form-heading">
                <p class="mini-label">Frontend-only form</p>
                <h3>Start a booking inquiry</h3>
              </div>
              <label>
                Name
                <input type="text" placeholder="Your name" />
              </label>
              <label>
                Email
                <input type="email" placeholder="you@example.com" />
              </label>
              <label>
                Dates
                <input type="text" placeholder="Preferred travel dates" />
              </label>
              <label>
                Message
                <textarea placeholder="Tell us a little about your stay..."></textarea>
              </label>
              <button class="button button-primary" type="button">Send inquiry</button>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
