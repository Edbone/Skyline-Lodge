---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { reviews } from '../data/reviews.js';
import ReviewCard from '../components/ReviewCard.astro';
const pageTitle = 'Reviews — Skyline Lodge';
const pageDescription = 'Guest reviews for Skyline Lodge, a Blue Ridge mountain cabin rental.';
const pageUrl = new URL('/reviews/', Astro.site);
const shareImage = new URL('/skyline-lodge-logo.png', Astro.site);
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/skyline-lodge-logo.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:alt" content="Skyline Lodge logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage.href} />
  </head>
  <body class="site-shell">
    <Navbar active="/reviews" />
    <main>
      <section class="section page-hero">
        <div class="container">
          <p class="eyebrow">Guest favorites</p>
          <h1 class="section-title">Reviews</h1>
          <p class="section-subtitle">See what guests love about Skyline Lodge and why this Blue Ridge cabin keeps feeling thoughtful, easy, and worth coming back to.</p>



          <div class="review-grid" style="margin-top: 2.5rem;">
            {reviews.map((review) => (
              <ReviewCard review={review} />
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
