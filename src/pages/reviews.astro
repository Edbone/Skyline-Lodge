---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { reviews } from '../data/reviews.js';
import ReviewCard from '../components/ReviewCard.astro';
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/skyline-lodge-logo.png" />
    <title>Reviews — Skyline Lodge</title>
    <meta name="description" content="Guest reviews for Skyline Lodge, a Blue Ridge mountain cabin rental." />
  </head>
  <body class="site-shell">
    <Navbar active="/reviews" />
    <main>
      <section class="section page-hero">
        <div class="container">
          <p class="eyebrow">Guest favorites</p>
          <h1 class="section-title">Reviews</h1>
          <p class="section-subtitle">See what guests love about Skyline Lodge and why this Blue Ridge cabin keeps feeling thoughtful, easy, and worth coming back to.</p>



          <div class="review-grid" style="margin-top: 2.5rem;">
            {reviews.map((review) => (
              <ReviewCard review={review} />
            ))}
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
