---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import PhotoSection from '../components/PhotoSection.astro';
import Footer from '../components/Footer.astro';
import { getGalleryPhotos } from '../data/photos.js';

const galleryPhotos = await getGalleryPhotos();
const pageTitle = 'Photos — Skyline Lodge';
const pageDescription = 'Browse photos of Skyline Lodge, a Blue Ridge mountain cabin with beautiful views and cozy spaces.';
const pageUrl = new URL('/photos/', Astro.site);
const shareImage = new URL('/skyline-lodge-logo.png', Astro.site);
---
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/skyline-lodge-logo.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl.href} />
    <meta property="og:image" content={shareImage.href} />
    <meta property="og:image:alt" content="Skyline Lodge logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={shareImage.href} />
  </head>
  <body class="site-shell">
    <Navbar active="/photos" />
    <main>
      <section class="section page-hero">
        <PhotoSection
          images={galleryPhotos}
          eyebrow="Photo gallery"
          title="Photos"
          subtitle="Browse the full Skyline Lodge gallery. Click any photo to enlarge it."
          sectionId="photos-gallery"
        />
      </section>
    </main>
    <Footer />
  </body>
</html>
