---
const images = Astro.props.images as Array<{ src: string; alt: string; title?: string; caption?: string }>;
const animationStyles = images
  .map((_, index) => `.hero-slide:nth-child(${index + 1}) { animation-delay: ${index * 5}s; }`)
  .join('\n');
---
<div class="hero-carousel" aria-label="Image carousel">
  {images.map((image) => (
    <div
      class="hero-slide"
      role="img"
      aria-label={image.alt}
      style={`background-image: url('${image.src}');`}>
    </div>
  ))}

  <div class="hero-content container">
    <div class="hero-copy">
      <h1>Skyline Lodge</h1>
      <div class="button-group">
        <a class="button button-primary" href="#photo-preview">View Photos</a>
        <a class="button button-secondary" href="/contact">Contact Us</a>
      </div>

      <div class="hero-highlights" aria-label="Property highlights">
      </div>
    </div>
  </div>

  <div class="hero-dots" aria-hidden="true">
    {images.map((image) => <span title={image.alt}></span>)}
  </div>
</div>

<style is:inline set:html={animationStyles}></style>
