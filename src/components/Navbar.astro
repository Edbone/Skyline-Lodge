---
const { active } = Astro.props;
const bookingUrl = 'https://www.escapetoblueridge.com/cabins/skyline-lodge';
const links = [
  { href: '/', label: 'Home' },
  { href: '/photos', label: 'Photos' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/recommendations', label: 'Our Favorites' },
  { href: bookingUrl, label: 'Book Now', external: true }
];
---
<nav class="navbar" aria-label="Primary navigation">
  <div class="navbar-inner">
    <a class="brand" href="/">
      <span class="brand-mark">Skyline</span>
      <span class="brand-name">Lodge</span>
    </a>

    <button class="hamburger" type="button" aria-expanded="false" aria-controls="nav-links-mobile" aria-label="Toggle navigation">
      <span class="hamburger-icon"></span>
    </button>

    <div class="nav-links">
      {links.map((link) => (
        <a
          class:list={['nav-link', link.external && 'nav-link-booking', active === link.href && 'is-active']}
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noreferrer' : undefined}
          aria-current={active === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>

    <div id="nav-links-mobile" class="nav-links-mobile">
      {links.map((link) => (
        <a
          class:list={['nav-link', link.external && 'nav-link-booking', active === link.href && 'is-active']}
          href={link.href}
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noreferrer' : undefined}
          aria-current={active === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('.navbar');
  const button = nav?.querySelector('.hamburger');
  const mobileMenu = nav?.querySelector('.nav-links-mobile');

  if (button instanceof HTMLButtonElement && mobileMenu instanceof HTMLElement) {
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      mobileMenu.classList.toggle('is-open', !expanded);
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        button.setAttribute('aria-expanded', 'false');
        mobileMenu.classList.remove('is-open');
      });
    });
  }
</script>
